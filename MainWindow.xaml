<Window x:Class="QuadBrowserLite.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="QuadBrowserLite (Private)" Width="1400" Height="900">
    <Window.Resources>
        <ContextMenu x:Key="TitleBarContextMenu">
            <MenuItem Header="設定..." Click="OnOpenSettingsClick" />
        </ContextMenu>
    </Window.Resources>

    <Grid x:Name="MainGrid">
        <Grid.RowDefinitions>
            <RowDefinition x:Name="TopRow" Height="*" />
            <RowDefinition Height="8" />
            <RowDefinition x:Name="BottomRow" Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="LeftCol" Width="*" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition x:Name="RightCol" Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左上 -->
        <wv2:WebView2 x:Name="WvTopLeft" Grid.Row="0" Grid.Column="0" />

        <!-- 縦の仕切り線（左右調整） -->
        <GridSplitter Grid.Row="0" Grid.Column="1" Width="8"
                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      ShowsPreview="True" />
        <GridSplitter Grid.Row="2" Grid.Column="1" Width="8"
                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      ShowsPreview="True" />

        <!-- 右上 -->
        <wv2:WebView2 x:Name="WvTopRight" Grid.Row="0" Grid.Column="2" />

        <!-- 横の仕切り線（上下調整） -->
        <GridSplitter Grid.Row="1" Grid.Column="0" Height="8"
                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      ShowsPreview="True" />
        <GridSplitter Grid.Row="1" Grid.Column="2" Height="8"
                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      ShowsPreview="True" />

        <!-- 中央の十字クロスポイント（上下・左右 両方向に調整可能） -->
        <Thumb x:Name="CrossPointThumb"
               Grid.Row="1" Grid.Column="1"
               Width="8" Height="8"
               Cursor="SizeAll"
               Background="#666666"
               DragDelta="OnCrossPointDragDelta" />

        <!-- 左下 -->
        <wv2:WebView2 x:Name="WvBottomLeft" Grid.Row="2" Grid.Column="0" />

        <!-- 右下 -->
        <wv2:WebView2 x:Name="WvBottomRight" Grid.Row="2" Grid.Column="2" />
    </Grid>
</Window>
