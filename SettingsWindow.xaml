<Window x:Class="QuadBrowserLite.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QuadBrowserLite - 4画面設定" Width="640" Height="420"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="PaneRowsPanel" />
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="キャンセル" Width="90" Height="30" Margin="0,0,8,0" Click="OnCancelClick" />
            <Button Content="反映して移動" Width="110" Height="30" IsDefault="True" Click="OnApplyClick" />
        </StackPanel>
    </Grid>
</Window>
