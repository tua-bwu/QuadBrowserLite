<Window x:Class="QuadBrowserLite.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QuadBrowserLite - 4画面設定" Width="760" Height="460"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 左上・右上 / 左下・右下の2x2配置 -->
        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border x:Name="CardTopLeft" Grid.Row="0" Grid.Column="0"
                    BorderBrush="LightGray" BorderThickness="1" CornerRadius="4"
                    Padding="10" Margin="0,0,6,6" />

            <Border x:Name="CardTopRight" Grid.Row="0" Grid.Column="1"
                    BorderBrush="LightGray" BorderThickness="1" CornerRadius="4"
                    Padding="10" Margin="6,0,0,6" />

            <Border x:Name="CardBottomLeft" Grid.Row="1" Grid.Column="0"
                    BorderBrush="LightGray" BorderThickness="1" CornerRadius="4"
                    Padding="10" Margin="0,6,6,0" />

            <Border x:Name="CardBottomRight" Grid.Row="1" Grid.Column="1"
                    BorderBrush="LightGray" BorderThickness="1" CornerRadius="4"
                    Padding="10" Margin="6,6,0,0" />
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="キャンセル" Width="90" Height="30" Margin="0,0,8,0" Click="OnCancelClick" />
            <Button Content="反映して移動" Width="110" Height="30" IsDefault="True" Click="OnApplyClick" />
        </StackPanel>
    </Grid>
</Window>
