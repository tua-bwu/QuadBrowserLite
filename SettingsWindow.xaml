<Window x:Class="QuadBrowserLite.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QuadBrowserLite - 4画面設定" Width="760" Height="540"
        MinWidth="640" MinHeight="440"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 左上・右上 / 左下・右下の2x2配置 -->
        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border x:Name="CardTopLeft" Grid.Row="0" Grid.Column="0"
                    BorderBrush="LightGray" BorderThickness="1" CornerRadius="4"
                    Padding="10" Margin="0,0,6,6" />

            <Border x:Name="CardTopRight" Grid.Row="0" Grid.Column="1"
                    BorderBrush="LightGray" BorderThickness="1" CornerRadius="4"
                    Padding="10" Margin="6,0,0,6" />

            <Border x:Name="CardBottomLeft" Grid.Row="1" Grid.Column="0"
                    BorderBrush="LightGray" BorderThickness="1" CornerRadius="4"
                    Padding="10" Margin="0,6,6,0" />

            <Border x:Name="CardBottomRight" Grid.Row="1" Grid.Column="1"
                    BorderBrush="LightGray" BorderThickness="1" CornerRadius="4"
                    Padding="10" Margin="6,6,0,0" />
        </Grid>

        <!-- URL の登録 -->
        <StackPanel Grid.Row="1" Margin="0,12,0,0">
            <DockPanel>
                <TextBlock Text="名前" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBox x:Name="NewNameBox" Width="140" Height="28" Margin="0,0,12,0"
                         VerticalContentAlignment="Center" KeyDown="OnRegisterBoxKeyDown" />
                <TextBlock Text="URL" VerticalAlignment="Center" Margin="0,0,6,0" />
                <Button DockPanel.Dock="Right" Content="登録" Width="90" Height="28" Margin="8,0,0,0"
                        Click="OnRegisterClick" />
                <TextBox x:Name="NewUrlBox" Height="28" VerticalContentAlignment="Center"
                         KeyDown="OnRegisterBoxKeyDown" />
            </DockPanel>
            <TextBlock x:Name="StatusText" Margin="0,6,0,0" Foreground="Gray" />
        </StackPanel>

        <DockPanel Grid.Row="2" Margin="0,8,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Left" Content="この配置で次回も起動" Width="170" Height="30"
                    Click="OnSaveStartupClick" />
            <Button DockPanel.Dock="Right" Content="4画面に反映" Width="110" Height="30" IsDefault="True" Click="OnApplyClick" />
            <Button DockPanel.Dock="Right" Content="キャンセル" Width="90" Height="30" Margin="0,0,8,0" Click="OnCancelClick" />
        </DockPanel>
    </Grid>
</Window>
